{
  "name": "dsh-chenchen",
  "version": "0.1.1",
  "description": "琛琛的身体层：让 DeepSeek Harness 里的陪伴人格真的能看屏幕、听歌、量电脑、做梦、叫停。全部零 token、纯本地。",
  "icon": "icon.png",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "companion",
    "desktop",
    "python"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trsing999/dsh-chenchen.git"
  },
  "homepage": "https://github.com/trsing999/dsh-chenchen#readme",
  "bugs": {
    "url": "https://github.com/trsing999/dsh-chenchen/issues"
  }
}
